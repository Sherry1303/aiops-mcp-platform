# aiops-api 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中忽略）
# MCP 生态根目录（server.py / inventory.json / audit.db 所在目录）
AIOPS_LEGACY_DIR=D:\mcp-vyos
# 拉起 MCP Server 的 Python 解释器（默认使用当前解释器）
# AIOPS_PYTHON=C:\Python314\python.exe
# 服务监听
AIOPS_HOST=0.0.0.0
AIOPS_PORT=8000
# 开发阶段允许所有来源；上线时改成具体域名，例如 http://localhost:5173
AIOPS_CORS_ORIGINS=*
# DeepSeek
DEEPSEEK_API_KEY=sk-替换成你自己的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
